# ---- Public (safe in the browser) -------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only (NEVER prefix with NEXT_PUBLIC_) ---------------------------
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
# Paystack → Settings → API Keys & Webhooks. Start with sk_test_...
PAYSTACK_SECRET_KEY=

# Price per published memorial, in minor units (cents). 29900 = R299.00
MEMORA_PUBLISH_PRICE_MINOR=29900
MEMORA_CURRENCY=ZAR
# Days a published memorial stays public before it becomes private.
MEMORA_PUBLIC_DAYS=90

# Local development only: 'true' makes checkout record a confirmed payment without
# Paystack. Ignored when NODE_ENV=production.
MEMORA_SIMULATE_PAYMENTS=false
