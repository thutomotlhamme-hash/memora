# ---- Public (safe in the browser) -------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only (NEVER prefix with NEXT_PUBLIC_) ---------------------------
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
# Yoco → Business Portal → Selling Online → Payment Gateway → API keys. Start with sk_test_...
YOCO_SECRET_KEY=
# Printed by `node scripts/register-yoco-webhook.mjs https://your-site` (whsec_...)
YOCO_WEBHOOK_SECRET=

# Plan prices (Essential R499 / Complete R899 / Forever R1 499) live in src/lib/plans.ts.

# Local development only: 'true' makes checkout record a confirmed payment without
# Yoco. Ignored when NODE_ENV=production.
MEMORA_SIMULATE_PAYMENTS=false
