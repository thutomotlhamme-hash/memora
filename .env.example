# ---- Public (safe in the browser) -------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only (NEVER prefix with NEXT_PUBLIC_) ---------------------------
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
# Yoco → Business Portal → Selling Online → Payment Gateway → API keys. Start with sk_test_...
YOCO_SECRET_KEY=
# Printed by `node scripts/register-yoco-webhook.mjs https://your-site` (whsec_...)
YOCO_WEBHOOK_SECRET=

# The price (Memora Complete, R899 for one year) lives in src/lib/plans.ts.

# ---- Gifts ---------------------------------------------------------------
# Signs private gift links. Any long random string (e.g. `openssl rand -base64 32`).
MEMORA_LINK_SECRET=
# Email via Resend (resend.com). From address must be on a domain verified in Resend.
RESEND_API_KEY=
MEMORA_FROM_EMAIL="Memora <gifts@your-domain.co.za>"
# Where new-gift and funeral-is-close alerts go (the team).
MEMORA_TEAM_EMAIL=
# Comma-separated emails allowed to open /admin (the gifts board).
MEMORA_ADMIN_EMAILS=
# Protects /api/cron/gift-reminders (hourly Netlify scheduled function). 16+ chars.
CRON_SECRET=
# Optional: automatic WhatsApp via Meta's WhatsApp Cloud API (needs an approved template).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GIFT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Local development only: 'true' makes checkout record a confirmed payment without
# Yoco. Ignored when NODE_ENV=production.
MEMORA_SIMULATE_PAYMENTS=false
