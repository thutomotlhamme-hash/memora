# ---- Public (safe in the browser) -------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public email for the footer and legal pages. Leave empty to send people to the /contact form.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_NAME=Memora
# Payments: leave empty for launch mode (publishing is free, gifts hidden). 'on' = charge R899 via Yoco.
NEXT_PUBLIC_MEMORA_PAYMENTS=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only (NEVER prefix with NEXT_PUBLIC_) ---------------------------
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
# Yoco → Business Portal → Selling Online → Payment Gateway → API keys. Start with sk_test_...
YOCO_SECRET_KEY=
# Printed by `node scripts/register-yoco-webhook.mjs https://your-site` (whsec_...)
YOCO_WEBHOOK_SECRET=

# The price (Memora Complete, R899 for one year) lives in src/lib/plans.ts.

# ---- Gifts ---------------------------------------------------------------
# Signs private gift links. Any long random string (e.g. `openssl rand -base64 32`).
MEMORA_LINK_SECRET=
# Comma-separated emails allowed to open /admin (the gifts board).
MEMORA_ADMIN_EMAILS=

# Local development only: 'true' makes checkout record a confirmed payment without
# Yoco. Ignored when NODE_ENV=production.
MEMORA_SIMULATE_PAYMENTS=false
